{
  "name": "datamitsu-vscode",
  "displayName": "datamitsu",
  "version": "0.0.0",
  "private": true,
  "description": "Format files with your datamitsu config, via the datamitsu language server.",
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "formatter",
    "lsp",
    "datamitsu"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/datamitsu/datamitsu.git",
    "directory": "editors/vscode"
  },
  "license": "MIT",
  "publisher": "datamitsu",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "tsdown",
    "package": "vsce package --no-dependencies -o dist/datamitsu.vsix",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "contributes": {
    "commands": [
      {
        "command": "datamitsu.restartServer",
        "title": "datamitsu: Restart Language Server"
      },
      {
        "command": "datamitsu.showOutput",
        "title": "datamitsu: Show Output Channel"
      }
    ],
    "configuration": {
      "title": "datamitsu",
      "properties": {
        "datamitsu.binaryMode": {
          "type": "string",
          "enum": [
            "auto",
            "system",
            "bundled"
          ],
          "enumDescriptions": [
            "Use a datamitsu found on PATH; if none, download the version pinned to this extension build.",
            "Use a datamitsu found on PATH only; error if none is found.",
            "Always use the version pinned to this extension build (ignore PATH)."
          ],
          "default": "auto",
          "description": "How to locate the datamitsu binary that runs the language server."
        },
        "datamitsu.path": {
          "type": "string",
          "default": "",
          "description": "Explicit path to the datamitsu binary. Overrides datamitsu.binaryMode when set."
        },
        "datamitsu.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC traffic between VS Code and the datamitsu language server."
        }
      }
    }
  },
  "activationEvents": [
    "workspaceContains:datamitsu.config.js",
    "workspaceContains:datamitsu.config.mjs",
    "workspaceContains:datamitsu.config.ts"
  ],
  "devDependencies": {
    "@shibanet0/datamitsu-config": "catalog:",
    "@types/node": "26.0.0",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "3.6.0",
    "tsdown": "0.22.3",
    "tsx": "4.22.4",
    "vscode-languageclient": "10.0.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "vscode": "^1.91.0"
  }
}
