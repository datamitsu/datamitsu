{
  "name": "datamitsu-toolkit",
  "displayName": "Datamitsu Toolkit",
  "version": "0.0.1",
  "private": true,
  "description": "Format files with your datamitsu config, via the datamitsu language server.",
  "categories": [
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "formatter",
    "linter",
    "lsp",
    "datamitsu"
  ],
  "bugs": {
    "url": "https://github.com/datamitsu/datamitsu/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/datamitsu/datamitsu.git",
    "directory": "editors/vscode"
  },
  "license": "MIT",
  "publisher": "datamitsu",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "tsdown",
    "codegen": "tsx scripts/gen-binaries.ts",
    "package": "vsce package --no-dependencies -o dist/datamitsu.vsix",
    "test": "node --import tsx --test 'src/**/*.test.ts'"
  },
  "contributes": {
    "commands": [
      {
        "command": "datamitsu.restartServer",
        "title": "datamitsu: Restart Language Server"
      },
      {
        "command": "datamitsu.showOutput",
        "title": "datamitsu: Show Output Channel"
      }
    ],
    "configuration": {
      "title": "datamitsu",
      "properties": {
        "datamitsu.binaryMode": {
          "type": "string",
          "enum": [
            "auto",
            "system",
            "bundled"
          ],
          "enumDescriptions": [
            "Use a datamitsu found on PATH; if none, download the version pinned to this extension build.",
            "Use a datamitsu found on PATH only; error if none is found.",
            "Always use the version pinned to this extension build (ignore PATH)."
          ],
          "default": "auto",
          "description": "How to locate the datamitsu binary that runs the language server."
        },
        "datamitsu.path": {
          "type": "string",
          "default": "",
          "description": "Explicit path to the datamitsu binary. Overrides datamitsu.binaryMode when set."
        },
        "datamitsu.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the JSON-RPC traffic between VS Code and the datamitsu language server."
        }
      }
    }
  },
  "activationEvents": [
    "workspaceContains:datamitsu.config.js",
    "workspaceContains:datamitsu.config.mjs",
    "workspaceContains:datamitsu.config.ts"
  ],
  "devDependencies": {
    "@shibanet0/datamitsu-config": "catalog:",
    "@types/node": "26.2.0",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "3.9.2",
    "ovsx": "1.1.1",
    "tsdown": "0.22.14",
    "tsx": "4.23.12",
    "vscode-languageclient": "10.1.0"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "icon": "icon.png",
  "preview": true,
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Datamitsu evaluates datamitsu.config.{js,mjs,ts} as code and runs workspace-configured tools, so it requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Datamitsu spawns a native binary and needs direct local filesystem access; it cannot operate on a virtual filesystem."
    }
  },
  "extensionKind": [
    "workspace"
  ]
}
