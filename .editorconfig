root = true

[*]
charset                  = utf-8
end_of_line              = lf
indent_size              = 2
insert_final_newline     = true
trim_trailing_whitespace = true

[GNUmakefile]
indent_size  = 2
indent_style = tab

[Makefile]
indent_size  = 2
indent_style = tab

# The generated bundle contains whitespace inside JavaScript template literals.
[internal/inspector/inspector.html]
trim_trailing_whitespace = false
