<?xml version="1.0" encoding="UTF-8"?><checkstyle version="4.3"><file name="Dockerfile"><error column="1" line="1" message="Always tag the version of an image explicitly" severity="warning" source="DL3006"/><error column="1" line="2" message="Pin versions in apt get install. Instead of `apt-get install &lt;package>` use `apt-get install &lt;package>=&lt;version>`" severity="warning" source="DL3008"/><error column="1" line="2" message="Avoid additional packages by specifying `--no-install-recommends`" severity="info" source="DL3015"/></file></checkstyle>