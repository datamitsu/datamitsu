{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist"],
  "extends": "@shibanet0/datamitsu-config/tsconfig/base.json",
  "include": ["src/**/*", "scripts/**/*"]
}
