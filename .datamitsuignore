# Generated by `datamitsu config reconcile --opt-in-tools`.
# All configured tools are disabled by default (opt-in model).
# Enable a tool by removing it from the list below (or add "!**/*: <tool>").
website/**/*: tsc
**/*: actionlint, bearer, droast, grype, harper-cli, knip, lychee, lychee-offline, markdownlint-cli2, osv-scanner, trivy, trufflehog, typos, vale

# The embedded documentation snapshot is a verbatim copy of the Docusaurus llms
# output, written by `task gen:llms-docs`. Its bytes are hashed into
# manifest.json and diffed by the llms-docs-drift CI job, so any formatter
# touching it would break that identity and flap the gate. Edit website/docs and
# re-harvest instead.
internal/llmsdocs/embed/**/*: *
website/docs/contributing/creating-wrappers.md: prettier
packaging/python/pyproject.toml: oxfmt
Taskfile.yaml: oxfmt
.github/workflows/pr-checks.yml: oxfmt
.github/workflows/release.yml: oxfmt

# Minified HTML is generated from inspector/ and embedded byte-for-byte.
internal/inspector/inspector.html: *

# Tool output recorded byte for byte for the parser tests, misspellings and all:
# a fixer would change what the tool printed, and a linter would judge it.
parsers/datamitsu-parsers/fixtures/*/*: *

# The problem matchers GitHub's setup actions register, vendored byte for byte
# from the upstream commits matchers_test.go names: no tool may rewrite or judge
# them.
internal/report/render/github/testdata/matchers/*: *

# The schemas the interchange formats are validated against, vendored byte for
# byte from their publishers (each renderer's test names the source): no tool
# may rewrite or judge them.
internal/report/render/*/testdata/schema/*: *

# Vendored verbatim from a datamitsu-config release (see test/cli/README.md); it
# is a bundle, re-fetched rather than edited, so no tool may rewrite or judge it.
test/e2e/testdata/datamitsu.config.oci-ghcr.js: *

# Preserve the bundled font's upstream license verbatim.
website/static/fonts/ibm-plex-mono-OFL.txt: *
